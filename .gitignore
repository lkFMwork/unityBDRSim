# =============================================================
#  Unity / Fitzmark BDR Simulator .gitignore
# =============================================================

# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Auto-generated solution / project files (regenerated by the IDE package)
*.csproj
*.sln
*.user
*.userprefs
*.unityproj
*.suo
*.tmp
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# IDEs
.vs/
.idea/
.vscode/
.gradle/

# Crash / diagnostic reports
sysinfo.txt
crashlytics-build.properties

# OS cruft
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# Packaged builds / artifacts
*.apk
*.aab
*.app
*.ipa
*.unitypackage
